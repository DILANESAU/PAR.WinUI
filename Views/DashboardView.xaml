<Page
    x:Class="PAR.WinUI.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="20" RowSpacing="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="8" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Panel General" FontSize="26" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,5,0,0" Opacity="0.6">
                                <FontIcon Glyph="&#xE787;" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PeriodoSeleccionado}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding Periodos}" 
                                      SelectedItem="{Binding PeriodoSeleccionado}"
                                      Width="150" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding Sucursales}" 
                                      SelectedItem="{Binding SucursalSeleccionada}"
                                      DisplayMemberPath="Nombre"
                                      Width="250" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="8" Padding="20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1565C0" Offset="0"/>
                                <GradientStop Color="#4527A0" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Ventas Totales" Foreground="White" Opacity="0.8" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding KpiVentasDisplay}" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="8" Padding="20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00B4DB" Offset="0"/>
                                <GradientStop Color="#0083B0" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Litros Totales" Foreground="White" Opacity="0.8" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding KpiLitros}" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" CornerRadius="8" Padding="15" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8EC;" Foreground="#4CAF50" FontSize="24" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding KpiPrecioPromedio}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Precio Promedio" Opacity="0.5" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" CornerRadius="8" Padding="15" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A1;" Foreground="Orange" FontSize="24" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding KpiTransacciones}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Transacciones" Opacity="0.5" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" CornerRadius="8" Padding="15" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE716;" Foreground="Teal" FontSize="24" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding KpiClientes}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Clientes Activos" Opacity="0.5" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" CornerRadius="8" Padding="25" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="300"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Tendencia de Ventas" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Evolución diaria de facturación" FontSize="12" Opacity="0.5"/>
                        </StackPanel>

                        <lvc:CartesianChart Grid.Row="1" 
                                            Series="{Binding SeriesVentas}" 
                                            XAxes="{Binding EjeX}"
                                            YAxes="{Binding EjeY}"
                                            TooltipPosition="Top" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="8" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Top Clientes" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                            <ItemsControl ItemsSource="{Binding TopProductosList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="40, *, Auto" Margin="0,8">
                                            <TextBlock Text="{Binding Ranking}" FontWeight="Bold" Opacity="0.5" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE77B;" FontSize="16" Opacity="0.5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding MontoDisplay}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="8" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Actividad Reciente" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                            <ItemsControl ItemsSource="{Binding UltimosClientesList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,15">
                                            <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Iniciales}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FechaDisplay}" FontSize="11" Opacity="0.5"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.8" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <ProgressRing IsActive="{Binding IsLoading}" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        </Grid>

    </Grid>
</Page>