<Window
    x:Class="PAR.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PAR Intelligence">

    <Grid>
        <NavigationView x:Name="NavView" 
                        ItemInvoked="NavView_ItemInvoked" 
                        Loaded="NavView_Loaded"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Auto">

            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="Dashboard" Tag="Dashboard"/>
                <NavigationViewItem Icon="People" Content="Clientes" Tag="Clientes"/>
                <NavigationViewItem Icon="Library" Content="Familias" Tag="Familias"/>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Padding="0,20,0,0" />

        </NavigationView>
    </Grid>
</Window>